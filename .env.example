# SERVIXA Environment Configuration
# Copy this file to .env and customize

# === API Configuration ===

# Backend URL (use ngrok URL for mobile access)
BASE_URL=http://localhost:3000

# Frontend API URL (used by the Expo app)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Backend port (default: 3000)
# PORT=3000

# Database file path (default: ./servixa.db)
# SERVIXA_DB_PATH=./servixa.db

# === Authentication ===

# Allowed origins for CORS (comma-separated)
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8081

# === ngrok (optional) ===

# For mobile testing with a physical device, use ngrok:
#   1. Install ngrok: https://ngrok.com/download
#   2. Start tunnel: ngrok http 3000
#   3. Copy the HTTPS URL and set it in BASE_URL and EXPO_PUBLIC_API_URL
#   4. Also set BETTER_AUTH_TRUSTED_ORIGINS to that URL
#
# Example with ngrok:
#   BASE_URL=https://seu-subdominio.ngrok-free.dev
#   EXPO_PUBLIC_API_URL=https://seu-subdominio.ngrok-free.dev/api
#   BETTER_AUTH_TRUSTED_ORIGINS=https://seu-subdominio.ngrok-free.dev

# ngrok authtoken (for programmatic tunnel or Docker tunnel)
# Obtenha em: https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=seu-token-aqui
